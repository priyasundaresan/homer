<mujoco model="tidybot_yam">
  <compiler angle="radian"/>

  <option integrator="implicitfast"/>
  <option cone="elliptic" impratio="10"/>

  <default>
    <default class="base">
      <default class="base/visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="base/collision">
        <geom type="mesh" group="3"/>
      </default>
    </default>

    <default class="yam">
      <position inheritrange="1"/>
      <joint frictionloss="0.1" axis="0 0 1"/>
      <default class="yam/dm4340">
        <joint armature="0.032"/>
        <position kp="600" kv="30" forcerange="-28 28"/>
      </default>
      <default class="yam/dm4310">
        <joint armature="0.0018"/>
        <position kp="200" kv="20" forcerange="-10 10"/>
      </default>
      <default class="yam/visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2" material="yam/black"/>
      </default>
      <default class="yam/collision">
        <geom group="3" type="capsule"/>
        <default class="yam/sphere_collision">
          <geom size="0.0006 0 0" type="sphere" rgba="1 0 0 1"/>
        </default>
      </default>
      <default class="yam/finger">
        <joint type="slide" armature="0.1" frictionloss="0.1"/>
        <position ctrlrange="0.0 0.041" kp="500" kv="20" inheritrange="0"/>
      </default>
    </default>
  </default>

  <asset>
    <!-- Base meshes -->
    <material name="base/silver" rgba="0.75294118 0.75294118 0.75294118 1"/>
    <material name="base/black"  rgba="0.30196078 0.30196078 0.30196078 1"/>
    <mesh name="base/body"      file="assets/base/body.stl"/>
    <mesh name="base/arm_plate" file="assets/base/arm_plate.stl"/>

    <!-- YAM arm materials and meshes -->
    <material name="yam/black" rgba="0.25 0.25 0.25 1"/>
    <material name="yam/white" rgba="0.9 0.9 0.9 1"/>
    <mesh name="yam/model2"    file="yam_assets/model2.stl"/>
    <mesh name="yam/model2__2" file="yam_assets/model2__2.stl"/>
    <mesh name="yam/model2__3" file="yam_assets/model2__3.stl"/>
    <mesh name="yam/model2__4" file="yam_assets/model2__4.stl"/>
    <mesh name="yam/model2__5" file="yam_assets/model2__5.stl"/>
    <mesh name="yam/model2__6" file="yam_assets/model2__6.stl"/>
    <mesh name="yam/model2__7" file="yam_assets/model2__7.stl"/>
    <mesh name="yam/model2__8" file="yam_assets/model2__8.stl"/>
    <mesh name="yam/model2__9" file="yam_assets/model2__9.stl"/>
    <mesh name="yam/model2__10" file="yam_assets/model2__10.stl"/>
    <mesh name="yam/model2__11" file="yam_assets/model2__11.stl"/>
    <mesh name="yam/model2__12" file="yam_assets/model2__12.stl"/>
    <mesh name="yam/model2__13" file="yam_assets/model2__13.stl"/>
    <mesh name="yam/model2__14" file="yam_assets/model2__14.stl"/>
    <mesh name="yam/model2__15" file="yam_assets/model2__15.stl"/>
    <mesh name="yam/model2__16" file="yam_assets/model2__16.stl"/>
    <mesh name="yam/model2__17" file="yam_assets/model2__17.stl"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="link_6" pos="0 0 1.5"/>
    <body name="base_link">
      <inertial pos="0 0 0.035" mass="60" diaginertia="0.001 0.001 0.001"/>
      <joint name="joint_x"  type="slide" axis="1 0 0"/>
      <joint name="joint_y"  type="slide" axis="0 1 0"/>
      <joint name="joint_th"/>

      <!-- TidyBot2 base geometry -->
      <geom class="base/visual"    mesh="base/body"      material="base/silver"/>
      <geom class="base/visual"    mesh="base/arm_plate" material="base/black"/>
      <geom class="base/collision" mesh="base/body"/>
      <geom class="base/collision" mesh="base/arm_plate"/>

      <!-- Base cameras (same positions as Kinova cube variant) -->
      <camera name="base1" pos="0.28 0.15 0.42" euler="-0.4 -0.6 -2.75" fovy="52" resolution="640 480"/>
      <camera name="base2" pos="0.28 -0.15 0.42" euler="0.4 -0.6 -0.81" fovy="52" resolution="640 480"/>

      <!-- YAM arm mounted at the same position as Gen3 -->
      <body name="arm" pos="0.1199 0 0.3948" childclass="yam">
        <geom class="yam/visual" pos="0 0 -0.0006" quat="1 0 0 1" mesh="yam/model2"/>
        <geom class="yam/collision" size="0.033 0.01" pos="0.0 0.0 0.026" quat="1 0 0 0"/>
        <body name="link_1" pos="0 0 0.0631" quat="1 0 0 1">
          <inertial pos="-0.00192861 -0.00795735 0.0208176" quat="0.297851 0.642634 0.360045 0.607185" mass="0.12415"
            diaginertia="0.000180751 0.000145532 5.89179e-05"/>
          <joint name="joint1" range="-2.61799 3.05433" class="yam/dm4340"/>
          <geom class="yam/visual" pos="5.26159e-07 2.34355e-07 -0.0632" quat="1 0 0 0" mesh="yam/model2__2"/>
          <body name="link_2" pos="2.5e-05 -0.02 0.0409" quat="1 1 1 1" gravcomp="1">
            <inertial pos="0.132008 2.10599e-06 0.000293073" quat="1 1 1 1" mass="1.24434"
              diaginertia="0.0121902 0.0121318 0.000683304"/>
            <joint name="joint2" range="0 3.66519" class="yam/dm4340"/>
            <geom class="yam/visual" pos="0.0199992 -0.1041 -2.44738e-05" quat="1 -1 -1 -1" mesh="yam/model2__3"/>
            <geom class="yam/visual" pos="0.0199992 -0.1041 -2.44738e-05" quat="1 -1 -1 -1" mesh="yam/model2__4"/>
            <geom class="yam/visual" pos="0.0199992 -0.1041 -2.44738e-05" quat="1 -1 -1 -1" mesh="yam/model2__5" material="yam/white"/>
            <geom class="yam/collision" size="0.032 0.11" pos="0.13 0 0" quat="1 0 1 0"/>
            <geom class="yam/collision" size="0.033 0.02" pos="0 0.0 0" quat="1 0 0 0"/>
            <geom class="yam/collision" size="0.033 0.025" pos="0.265 0 0" quat="1 0 0 0"/>
            <body name="link_3" pos="0.264 0 0" quat="0 1 0 0" gravcomp="1">
              <inertial pos="-0.121816 -0.054846 -0.000111108" quat="1 1 1 1" mass="0.853698"
                diaginertia="0.00699732 0.00696112 0.000788244"/>
              <joint name="joint3" range="0 3.66519" class="yam/dm4340"/>
              <geom class="yam/visual" pos="-0.244001 0.104101 2.44738e-05" quat="1 1 1 -1" mesh="yam/model2__6"/>
              <geom class="yam/visual" pos="-0.244001 0.104101 2.44738e-05" quat="1 1 1 -1" mesh="yam/model2__7"/>
              <geom class="yam/visual" pos="-0.244001 0.104101 2.44738e-05" quat="1 1 1 -1" mesh="yam/model2__8" material="yam/white"/>
              <geom class="yam/visual" pos="-0.244001 0.104101 2.44738e-05" quat="1 1 1 -1" mesh="yam/model2__9"/>
              <geom class="yam/collision" size="0.034 0.12" pos="-0.14 -0.06 0.0" quat="1 0 1 0"/>
              <geom class="yam/collision" size="0.034 0.015" pos="-0.24 -0.06 0.0" quat="1 0 0 0"/>
              <body name="link_4" pos="-0.245 -0.06 0" quat="1 0 0 0" gravcomp="1">
                <inertial pos="-0.0769778 -0.0527104 0.000154878" quat="0.667 0.667 -0.236 -0.236" mass="0.463511"
                  diaginertia="0.000791532 0.000744733 0.000282116"/>
                <joint name="joint4" range="-1.5708 1.5708" class="yam/dm4310"/>
                <geom class="yam/visual" pos="0.00100023 0.164101 2.44738e-05" quat="1 1 1 -1" mesh="yam/model2__10"/>
                <geom class="yam/collision" size="0.03 0.015" pos="-0.073 -0.06 0.0" quat="1 1 0 0"/>
                <body name="link_5" pos="-0.074 -0.0395 2.5e-05" quat="1 -1 1 1" gravcomp="1">
                  <inertial pos="3.64861e-05 0.00025665 0.0353526" quat="1 0 0 0" mass="0.350962"
                    diaginertia="0.000197802 0.0001775 0.000147402"/>
                  <joint name="joint5" range="-1.5708 1.5708" class="yam/dm4310"/>
                  <geom class="yam/visual" pos="0 -0.0749971 0.203601" quat="1.32679e-06 1 0 0" mesh="yam/model2__11"/>
                  <geom class="yam/collision" size="0.030 0.015" pos="0 0.025 0.0395" quat="1 1 0 0"/>
                  <body name="link_6" pos="0 0.0353 0.0395" quat="1 -1 0 0" gravcomp="1">
                    <inertial pos="-0.000217767 7.37059e-05 0.0270545" quat="1 1 0 0" mass="0.367476"
                      diaginertia="0.000265958 0.000242686 0.000227409"/>
                    <joint name="joint6" range="-2.0944 2.0944" class="yam/dm4310"/>
                    <geom class="yam/visual" pos="0 -0.164101 -0.110597" quat="1 -1 0 0" mesh="yam/model2__12"/>
                    <geom class="yam/visual" pos="0 -0.164101 -0.110597" quat="1 -1 0 0" mesh="yam/model2__13"/>
                    <geom class="yam/collision" size="0.01 0.035" pos="0 0.039 0.052" quat="1 0 1 0"/>
                    <geom class="yam/collision" size="0.030 0.005" pos="0 0.0 0.03" quat="1 0 0 1"/>
                    <geom class="yam/collision" size="0.01 0.035" pos="0 -0.039 0.052" quat="1 0 1 0"/>
                    <!-- Wrist camera: inside gripper gap looking down toward floor -->
                    <camera name="wrist" pos="0 0.01 0.04" euler="3.14 0 3.14" fovy="60" resolution="640 480"/>
                    <!-- End-effector site (named pinch_site for homer compatibility) -->
                    <site name="pinch_site" pos="0 0 0.1347" quat="1 0 0 -1" size="0.005" rgba="0 1 0 1" group="4"/>
                    <body name="link_left_finger" pos="-0.037 0.0392 0.0605" quat="1 0 1 0" gravcomp="1">
                      <inertial pos="-0.0192995 -0.0365902 0.039774" quat="0.757351 0.568898 -0.3199 0.0" mass="0.118"
                        diaginertia="0.000159084 0.000154909 4.63655e-05"/>
                      <joint class="yam/finger" name="left_finger" range="-0.00205 0.037524"/>
                      <geom class="yam/visual" pos="0.171097 -0.203301 0.037" quat="1 -1 -1 -1" mesh="yam/model2__14"/>
                      <geom class="yam/visual" pos="0.171097 -0.203301 0.037" quat="1 -1 -1 -1" mesh="yam/model2__15"/>
                      <body name="lf_rot" quat="1 -1 -1 1" pos="0.0 -0.0392 0.037" gravcomp="1">
                        <geom class="yam/collision" size="0.01 0.03" pos="0.0 -0.02 0.012" quat="1 0 1 0" rgba="0.38 0.49 0.78 1"/>
                        <geom class="yam/collision" size="0.01 0.02" pos="-0.02 -0.01 0.032" quat="1 0 2.5 0" rgba="0.38 0.49 0.78 1"/>
                        <body name="lf_down" quat="1 0 0 0" pos="-0.044 0.0 0.0" gravcomp="1">
                          <geom class="yam/collision" size="0.01 0.01" pos="0.0 -0.020 0.012" quat="1 -0.1 0 0" rgba="0.38 0.49 0.78 1" friction="2.0" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"/>
                          <geom type="box" size="0.014 0.005 0.022" pos="0 0.004 0.06" rgba="0.5 0.6 0.9 1" friction="2.0" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"/>
                        </body>
                      </body>
                    </body>
                    <body name="link_right_finger" pos="0.037 -0.0392 0.0605" quat="1 0 1 0" gravcomp="1">
                      <inertial pos="-0.0192995 0.0365902 -0.039774" quat="-0.757351 0.568898 -0.3199 0" mass="0.118"
                        diaginertia="0.000159084 0.000154909 4.63655e-05"/>
                      <joint class="yam/finger" name="right_finger" range="-0.037524 0.00205"/>
                      <geom class="yam/visual" pos="0.171097 -0.124901 -0.037" quat="1 -1 -1 -1" mesh="yam/model2__16"/>
                      <geom class="yam/visual" pos="0.171097 -0.124901 -0.037" quat="1 -1 -1 -1" mesh="yam/model2__17"/>
                      <body name="rf_rot" quat="1 1 -1 -1" pos="0.0 0.0392 -0.037" gravcomp="1">
                        <geom class="yam/collision" size="0.01 0.03" pos="0.0 -0.02 0.012" quat="1 0 1 0" rgba="0.38 0.49 0.78 1"/>
                        <geom class="yam/collision" size="0.01 0.02" pos="0.02 -0.01 0.032" quat="1 0 -2.5 0" rgba="0.38 0.49 0.78 1"/>
                        <body name="rf_down" quat="1 0 0 0" pos="0.044 0.0 0.0" gravcomp="1">
                          <geom class="yam/collision" size="0.01 0.01" pos="0.0 -0.020 0.012" quat="1 -0.1 0 0" rgba="0.38 0.49 0.78 1" friction="2.0" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"/>
                          <geom type="box" size="0.014 0.005 0.022" pos="0 0.004 0.06" rgba="0.5 0.6 0.9 1" friction="2.0" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <joint joint1="left_finger" joint2="right_finger" polycoef="0 -1 0 0 0"/>
  </equality>

  <actuator>
    <!-- Mobile base -->
    <position name="joint_x"  joint="joint_x"  kp="1000000" kv="50000"/>
    <position name="joint_y"  joint="joint_y"  kp="1000000" kv="50000"/>
    <position name="joint_th" joint="joint_th" kp="50000"   kv="1000"/>
    <!-- YAM arm -->
    <position name="joint1" joint="joint1" class="yam/dm4340"/>
    <position name="joint2" joint="joint2" class="yam/dm4340"/>
    <position name="joint3" joint="joint3" class="yam/dm4340"/>
    <position name="joint4" joint="joint4" class="yam/dm4310" kp="200" kv="20"/>
    <position name="joint5" joint="joint5" class="yam/dm4310"/>
    <position name="joint6" joint="joint6" class="yam/dm4310"/>
    <!-- Gripper: controls left_finger; right_finger coupled via equality -->
    <position class="yam/finger" name="gripper" joint="left_finger"/>
  </actuator>

  <!-- qpos layout: joint_x joint_y joint_th | joint1..6 | left_finger right_finger -->
  <!-- No keyframe here: homer resets via arm_reset_qpos from config, not MuJoCo keyframes. -->

</mujoco>
